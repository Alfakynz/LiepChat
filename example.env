# URL of the frontend, used for CORS or redirection
FRONTEND_URL=http://localhost:5173

# Public Supabase API key
SUPABASE_KEY=your-public-supabase-key

# Supabase database password (keep this secure)
SUPABASE_PSW=your-database-password

# Supabase service role key (DO NOT expose this on the frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of your Supabase project
SUPABASE_URL=https://your-project-id.supabase.co

# URL of the backend API
VITE_SERVER_URL=http://localhost:3000

# URL of the websocket server
VITE_SOCKET_URL=http://localhost:3000